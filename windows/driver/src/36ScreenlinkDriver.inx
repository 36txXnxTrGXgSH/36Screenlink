; 36Screenlink : pilote d'affichage indirect (UMDF)

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=36ScreenlinkDriver.cat
DriverVer=

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0...19041

[Standard.NTamd64.10.0...19041]
%DeviceName%=Device_Install,36ScreenlinkIdd

[SourceDisksFiles]
36ScreenlinkDriver.dll=1

[SourceDisksNames]
1=%DiskName%

[Device_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[Device_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=Device_HardwareSettings

[Device_HardwareSettings]
HKR,,"UpperFilters",%REG_MULTI_SZ%,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",%REG_SZ%,"36ScreenlinkDriverGroup"

[Device_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[Device_Install.NT.Wdf]
UmdfService=36ScreenlinkDriver,36ScreenlinkDriver_Install
UmdfServiceOrder=36ScreenlinkDriver
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfHostProcessSharing=ProcessSharingDisabled
UmdfHostPriority=PriorityHigh

[36ScreenlinkDriver_Install]
UmdfLibraryVersion=2.27.0
ServiceBinary=%12%\UMDF\36ScreenlinkDriver.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF

[UMDriverCopy]
36ScreenlinkDriver.dll

[Strings]
ManufacturerName="36Screenlink"
DiskName="36Screenlink"
DeviceName="36Screenlink Display"
REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000
