<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://36screenlink.local/tv" version="2.0.1" viewmodes="maximized">
    <tizen:application id="S36LinkTV1.Screenlink" package="S36LinkTV1" required_version="5.5"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <name>36Screenlink</name>
    <description>Affiche l'écran du PC sur la télévision, à faible latence, sur le réseau local, chiffré, sans compte ni serveur.</description>
    <tizen:profile name="tv-samsung"/>
    <!-- Réseau local seulement : le PC de l'utilisateur. Aucun autre site n'est contacté. -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <access origin="*" subdomains="true"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
